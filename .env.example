# Read by the checkout backend. Installed tools use ~/.config/convo/.env, created by `convo --setup`.
DATABASE_URL=postgresql+psycopg://convo:convo@localhost:5432/convo
# ChatGPT OAuth tokens are stored in the OS keyring, not in this file.
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
# Raw relevance logit cutoff; tune against your files, not a probability.
RERANK_MIN_SCORE=-3
RETRIEVAL_CANDIDATES=20
# Optional alternative to Shift+Tab; F2 always opens the thinking picker.
CONVO_THINKING_KEY=ctrl+t
