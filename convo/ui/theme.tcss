Screen {
    background: #080808;
    color: #dddddd;
    padding: 2 3 1 3;
}
#masthead { height: 4; margin-bottom: 1; }
#brand { width: 29; height: 4; }
#identity { width: 1fr; height: 4; margin-left: 3; padding-top: 1; }
#version { height: 1; color: #a7a095; }
#tagline { height: 1; color: #777777; }
#directory { height: 1; color: #555555; }
#conversation { height: 1fr; min-height: 1; margin: 1 0; scrollbar-size: 1 1; scrollbar-color: #494134; scrollbar-background: #080808; }
#welcome { color: #888888; height: auto; }
.message { height: auto; margin-bottom: 2; }
.user-message { background: #151515; border-left: solid #e6b85c; padding: 1 2; color: #eeeeee; }
.assistant-message { padding: 0 3; }
.notice-message { padding: 0 3; color: #bbbbbb; margin-bottom: 1; }
.source-message { background: #0e0e0e; border-left: solid #494134; padding: 1 2; color: #aaaaaa; }
.error-message { border-left: solid #b97863; padding: 0 2; }
#composer { height: auto; }
#input-panel { height: auto; background: #191919; border-left: solid #e6b85c; padding: 1 2; }
#settings { height: 1; margin-top: 1; }
#selection { height: 1; width: 1fr; min-width: 0; color: #e6b85c; }
#thinking { height: 1; width: auto; margin-left: 2; color: #e6b85c; }
#prompt { height: 1; border: none; background: #191919; padding: 0; }
#prompt:focus { border: none; background: #191919; }
#prompt:disabled { opacity: 60%; }
Input { color: #eeeeee; }
Input > .input--placeholder { color: #666666; }
#status { height: 1; color: #888888; margin-top: 1; }
#keys { height: 1; color: #666055; margin-top: 1; }
#command-menu { display: none; border: solid #494134; background: #0c0c0c; padding: 0; margin-bottom: 1; scrollbar-size: 1 1; scrollbar-color: #6d582f; scrollbar-background: #0c0c0c; }
#command-menu > .option-list--option-highlighted { background: #292318; color: #f2cc70; }
FilePicker, ModelPicker, SessionPicker, ThinkingPicker { align: center middle; background: #000000 75%; padding: 1; }
#picker, #model-picker, #session-picker, #thinking-picker { width: 80; max-width: 100%; height: 24; max-height: 100%; background: #0c0c0c; border: solid #a18245; padding: 1 2; }
#thinking-picker { width: 52; height: auto; max-height: 100%; }
#picker-title, #model-title, #session-title, #thinking-title { height: 1; color: #e6b85c; text-style: bold; margin-bottom: 1; }
#picker-path, #model-subtitle, #session-subtitle, #thinking-subtitle { height: 1; color: #888888; margin-bottom: 1; }
#file-search, #model-search, #session-search { height: 3; border: solid #444444; background: #0c0c0c; }
#file-search:focus, #model-search:focus, #session-search:focus { border: solid #e6b85c; }
#file-options, #model-options, #session-options, #thinking-options { height: 1fr; border: none; background: #0c0c0c; padding: 0; margin-top: 1; scrollbar-size: 1 1; scrollbar-color: #6d582f; scrollbar-background: #0c0c0c; }
#thinking-options { height: auto; max-height: 8; margin-top: 0; }
#file-options > .option-list--option-highlighted, #model-options > .option-list--option-highlighted, #session-options > .option-list--option-highlighted, #thinking-options > .option-list--option-highlighted { background: #292318; color: #f2cc70; text-style: none; }
#picker-help, #model-help, #session-help, #thinking-help { height: auto; color: #777777; margin-top: 1; }
Screen.compact { padding: 1; }
Screen.compact #masthead { height: 1; margin-bottom: 0; }
Screen.compact #brand { width: 1fr; height: 1; }
Screen.compact #identity { display: none; }
Screen.compact #conversation { margin: 1 0 0 0; }
Screen.compact #input-panel { padding: 0 1; }
Screen.compact #settings { margin-top: 0; }
Screen.compact #status { margin-top: 0; }
Screen.compact #keys { margin-top: 0; }
Screen.compact #command-menu { margin-bottom: 0; }
ThinkingPicker.compact #thinking-picker { padding: 0 2; }
ThinkingPicker.compact #thinking-title, ThinkingPicker.compact #thinking-subtitle { margin-bottom: 0; }
Screen.chatting { padding: 1 2; }
Screen.chatting #masthead { height: 1; margin-bottom: 0; }
Screen.chatting #brand { width: 1fr; height: 1; }
Screen.chatting #identity { display: none; }
Screen.chatting.compact { padding: 1; }
Screen.compact .message { margin-bottom: 1; }
Screen.compact .user-message, Screen.compact .source-message { padding: 0 1; }
Screen.compact .assistant-message, Screen.compact .notice-message { padding: 0 2; }
